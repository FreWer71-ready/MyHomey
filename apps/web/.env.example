# Supabase-projektet homey-dashboard (publika värden, säkra i webbläsaren)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Publik adress i produktion (appen nås via trand.se/mydashboard)
PUBLIC_ORIGIN=https://trand.se
# Hemliga iCal-adresser till hushållets Google-kalendrar (Inställningar -> Integrera kalender -> Hemlig adress i iCal-format).
# Flera kalendrar: separera adresserna med mellanslag.
CALENDAR_ICAL_URL=
CALENDAR_ICAL_URL_WORK=
CALENDAR_ICAL_URL_INNEBANDY=
# Namn som inte ska visas i Snabbval på Hem, semikolonseparerade (t.ex. en Hue-scen som dubblerar en knapp).
QUICK_HIDE=
# Fotboll (Forza): lag-id, kommaseparerade. Lagets matcher visas som en egen kalender (11413 = Hammarby IF).
FORZA_TEAMS=
# Ulrikas kalender (sätts bara i hennes installation)
ULRIKA_ICAL_URL=
