# Supabase-projektet homey-dashboard (publika värden, säkra i webbläsaren)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Publik adress i produktion (appen nås via trand.se/mydashboard)
PUBLIC_ORIGIN=https://trand.se
# Hemliga iCal-adresser till hushållets Google-kalendrar (Inställningar -> Integrera kalender -> Hemlig adress i iCal-format).
# Flera kalendrar: separera adresserna med mellanslag.
CALENDAR_ICAL_URL=
# Ulrikas kalender (sätts bara i hennes installation)
ULRIKA_ICAL_URL=
