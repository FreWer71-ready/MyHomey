# Supabase-projektet homey-dashboard (publika värden, säkra i webbläsaren)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Publik adress i produktion (appen nås via trand.se/mydashboard)
PUBLIC_ORIGIN=https://trand.se
# Hemlig iCal-adress till hushållets Google-kalender (Inställningar -> Integrera kalender -> Hemlig adress i iCal-format)
CALENDAR_ICAL_URL=
# Ulrikas kalender (sätts bara i hennes installation)
ULRIKA_ICAL_URL=
